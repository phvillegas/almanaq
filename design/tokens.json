{
  "$comment": "Fuente única de verdad de color. Sistema 'Sol y Luna'. Los hexadecimales son idénticos en iOS y Android. Ver PLAN.md sección 6.",
  "meta": {
    "name": "Sol y Luna",
    "version": 1,
    "seed": "#4436C7",
    "seedNote": "Semilla para generar el esquema de Material 3 en Android con Material Theme Builder."
  },

  "palette": {
    "vesper": {
      "700": "#302683",
      "600": "#3A2DA8",
      "500": "#4436C7",
      "300": "#8B7DFF",
      "200": "#B9AEFF",
      "100": "#DEDAF6",
      "050": "#E7E5F8",
      "$comment": "Índigo. Color de acción y de marca. 500 en claro, 300 en oscuro."
    },
    "meridian": {
      "600": "#8A5A0B",
      "500": "#E0A03A",
      "400": "#F0B455",
      "100": "#FBF0DC",
      "$comment": "Azafrán. Acento y alerta. 600 es la única variante apta para texto sobre fondo claro."
    },
    "neutral": {
      "paper": "#F7F7FA",
      "mist": "#E4E4EC",
      "slateLight": "#9C9DB4",
      "slate": "#5B5C74",
      "nocturne": "#171634",
      "surfaceDark": "#1A1930",
      "surfaceDarkTonal": "#1F1E38",
      "void": "#0F0E1C",
      "borderDark": "#2A2947",
      "starlight": "#F2F2F7",
      "white": "#FFFFFF"
    },
    "green": {
      "600": "#17724E",
      "400": "#3DBE8B",
      "100": "#E3F3EB",
      "dark": "#12291F"
    }
  },

  "theme": {
    "light": {
      "background": "#F7F7FA",
      "surface": "#FFFFFF",
      "surfaceTonal": "#EAEAF2",
      "textPrimary": "#171634",
      "textSecondary": "#5B5C74",
      "textDisabled": "#9C9DB4",
      "textOnAccent": "#FFFFFF",
      "accent": "#4436C7",
      "accentPressed": "#3A2DA8",
      "accentSubtle": "#E7E5F8",
      "border": "#E4E4EC",
      "scrim": "rgba(23, 22, 52, 0.45)"
    },
    "dark": {
      "background": "#0F0E1C",
      "surface": "#1A1930",
      "surfaceTonal": "#1F1E38",
      "textPrimary": "#F2F2F7",
      "textSecondary": "#9C9DB4",
      "textDisabled": "#6E6F87",
      "textOnAccent": "#0E1420",
      "accent": "#8B7DFF",
      "accentPressed": "#B9AEFF",
      "accentSubtle": "#2A2456",
      "border": "#2A2947",
      "scrim": "rgba(0, 0, 0, 0.6)"
    }
  },

  "status": {
    "$comment": "Mapeo directo del enum de la API. El cliente no decide colores: recibe el status y busca acá.",
    "AVAILABLE": {
      "light": { "text": "#17724E", "dot": "#17724E", "container": "#E3F3EB", "avatarBg": "#E3F3EB", "avatarText": "#17724E" },
      "dark":  { "text": "#3DBE8B", "dot": "#3DBE8B", "container": "#12291F", "avatarBg": "#12291F", "avatarText": "#3DBE8B" }
    },
    "OFF_HOURS": {
      "light": { "text": "#9C9DB4", "dot": "#B9BACB", "container": null, "avatarBg": "#E7E5F8", "avatarText": "#4436C7" },
      "dark":  { "text": "#9C9DB4", "dot": "#6E6F87", "container": null, "avatarBg": "#2A2456", "avatarText": "#B9AEFF" }
    },
    "LOCAL_WEEKEND": {
      "light": { "text": "#8A5A0B", "dot": "#E0A03A", "container": "#FBF0DC", "avatarBg": "#E7E5F8", "avatarText": "#4436C7" },
      "dark":  { "text": "#F0B455", "dot": "#F0B455", "container": "#2A2216", "avatarBg": "#2A2456", "avatarText": "#B9AEFF" }
    },
    "LOCAL_HOLIDAY": {
      "light": { "text": "#8A5A0B", "dot": "#E0A03A", "container": "#FBF0DC", "avatarBg": "#E7E5F8", "avatarText": "#4436C7" },
      "dark":  { "text": "#F0B455", "dot": "#F0B455", "container": "#2A2216", "avatarBg": "#2A2456", "avatarText": "#B9AEFF" }
    },
    "UNKNOWN": {
      "light": { "text": "#9C9DB4", "dot": "#B9BACB", "container": null, "avatarBg": "#E7E5F8", "avatarText": "#4436C7" },
      "dark":  { "text": "#9C9DB4", "dot": "#6E6F87", "container": null, "avatarBg": "#2A2456", "avatarText": "#B9AEFF" }
    }
  },

  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48 },

  "radius": {
    "ios":     { "card": 13, "control": 12, "pill": 999 },
    "android": { "card": 18, "control": 20, "pill": 999 }
  },

  "typography": {
    "display":  { "size": 46, "weight": 700, "lineHeight": 52, "tracking": -1 },
    "title":    { "size": 26, "weight": 700, "lineHeight": 32, "tracking": -0.5 },
    "heading":  { "size": 19, "weight": 600, "lineHeight": 26, "tracking": 0 },
    "body":     { "size": 15, "weight": 400, "lineHeight": 22, "tracking": 0 },
    "label":    { "size": 13, "weight": 500, "lineHeight": 18, "tracking": 0 },
    "caption":  { "size": 11, "weight": 600, "lineHeight": 16, "tracking": 1.6, "uppercase": true }
  },

  "rules": [
    "meridian.500 (#E0A03A) NUNCA como texto sobre fondo claro: da 2.1:1. Usar meridian.600 (#8A5A0B).",
    "Relleno vesper.300 (#8B7DFF) en tema oscuro lleva texto #0E1420, no blanco: blanco da 3.2:1.",
    "En tema oscuro la jerarquía se da con superficies, no con sombras.",
    "Toda combinación texto/fondo nueva debe superar 4.5:1 en ambos temas.",
    "Las horas locales y los contadores usan cifras tabulares.",
    "iOS: Liquid Glass solo en el chrome (tab bar, navegación, sheets). Contenido siempre opaco.",
    "Android: desactivar dynamic color de Material You explícitamente."
  ]
}
