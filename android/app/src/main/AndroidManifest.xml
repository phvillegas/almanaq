<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The backend resolves availability, so the app needs the network and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility for the one app this one ever talks to.

      From API 30 an app cannot see other packages unless it says which ones it cares
      about, and without this the platform logs the handoff as
      `AppsFilter: ... -> com.google.android.calendar BLOCKED`. `startActivity` still
      gets through, but any attempt to check for a calendar first comes back empty,
      which would make "no calendar app found" fire on phones that have one.

      Note what is *not* here: no calendar permission. The app hands a date over and
      reads nothing back. See PLAN.md section 2 — integration is out of scope, this is a
      platform intent.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Almanaq">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Almanaq"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
