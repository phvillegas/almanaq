<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the adaptive icon is shipped, with no mipmap-*dpi fallbacks: minSdk is 26 and
  adaptive icons landed in 26, so the legacy bitmaps would be dead weight.
-->
